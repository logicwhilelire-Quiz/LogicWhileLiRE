# ==============================================================================
# GROWTHRAN — Client Environment Configuration
# Developer: R. Charan Sai
# Brand: GROWTHRAN | "Learn. Grow. Run."
# ==============================================================================
# Copy this file to .env and fill each value.
# All VITE_ variables are bundled into the client build — never put secrets here.
# ==============================================================================

# Backend API base URL
# Local development:  http://localhost:3001
# Production:         https://api.growthran.com
VITE_API_BASE_URL=https://your-backend-domain.com
VITE_API_URL=https://your-backend-domain.com

# Supabase Project Credentials (public anon key only — service role stays server-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags (optional)
VITE_ENABLE_PROCTORING=true
VITE_ENABLE_LEADERBOARD=true
