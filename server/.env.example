# ==============================================================================
# GROWTHRAN — Server Environment Configuration (Complete Reference)
# Developer: R. Charan Sai
# Brand: GROWTHRAN | "Learn. Grow. Run."
# ==============================================================================
# Copy this file to .env and fill every value.
# NEVER commit .env — it is gitignored.
# ==============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production                        # 'development' | 'production' | 'test'
PORT=3001                                  # HTTP server port

# ── Demo Mode (development / local preview ONLY) ─────────────────────────────
# Set to 'true' to run with in-memory mock data (no Supabase required).
# In production DEMO_MODE must be 'false' — the boot guard will refuse to start if true.
DEMO_MODE=false

# ── Database (Supabase) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — NEVER expose to browser
SUPABASE_ANON_KEY=your-anon-key                    # for client-facing realtime subscriptions only

# ── Auth — Participant & Admin JWTs ──────────────────────────────────────────
# Generate with:  openssl rand -hex 64
JWT_SECRET=REPLACE_ME_with_a_64_char_random_hex_string
ADMIN_JWT_SECRET=REPLACE_ME_with_a_different_64_char_random_hex_string
JWT_EXPIRY=3h                              # match to longest exam duration + buffer

# ── Admin Bootstrap Credentials ──────────────────────────────────────────────
# Username (or email) for the bootstrap super-admin account
ADMIN_USERNAME=your-admin-username
INITIAL_ADMIN_EMAIL=admin@yourdomain.com  # used as bootstrap admin email if no staff row in DB

# Bcrypt hash of the super-admin password (NEVER store plaintext).
# Generate: node -e "const b=require('bcrypt');b.hash('YOUR_STRONG_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$PLACEHOLDER_REPLACE_WITH_REAL_BCRYPT_HASH

# ── Email / SMTP (Exam Alerts, OTP, Notifications) ───────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-sending-address@domain.com
SMTP_PASS=your-app-password
SMTP_SECURE=false                          # Set 'true' for port 465 (TLS), 'false' for STARTTLS

# Sender identity displayed in email clients
EMAIL_FROM=noreply@growthran.com
EMAIL_FROM_NAME=GROWTHRAN Platform

# Recipient for admin security alerts (terminations, anomalies)
ADMIN_ALERT_EMAIL=alerts@yourdomain.com   # Defaults to SMTP_USER if unset

# OTP configuration
OTP_EXPIRY_MINUTES=5

# ── Proctoring & Exam Policy ─────────────────────────────────────────────────
VIOLATION_THRESHOLD=2                     # Tab-switch violations before auto-terminate

# ── Networking & Security ────────────────────────────────────────────────────
# CORS allowed origin(s). Comma-separated for multiple.
# Must be the exact https:// URL of your frontend.
CLIENT_ORIGIN=https://app.growthran.com

# Cookie / session secret (used for CSRF and session signing)
SESSION_SECRET=REPLACE_ME_with_another_64_char_random_hex_string

# ── Optional External Gateways ───────────────────────────────────────────────
# GPT-4o-mini question generator — leave unset to fall back to built-in synthesizer
OPENAI_API_KEY=sk-...

# Private Piston code execution gateway — leave unset to use built-in sandbox
PISTON_URL=https://emkc.org/api/v2/piston/execute

# ── Monitoring & Observability (Optional) ────────────────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=
