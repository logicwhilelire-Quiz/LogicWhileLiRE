# ==============================================================================
# LogicWhileLiRE — Server Environment Configuration Template
# Brand: LogicWhileLiRE | "Logic. While. LiRE."
# ==============================================================================
# Copy this file to server/.env and fill in every required value.
# NEVER commit your actual .env file — it is gitignored.
# ==============================================================================

# ── Runtime & Server ─────────────────────────────────────────────────────────
NODE_ENV=production                         # Environment mode: 'development' | 'production' | 'test'
PORT=3001                                   # Port on which the Express server listens (Render assigns this automatically)

# ── Demo Mode (Development / Local Preview ONLY) ────────────────────────────
# Must be 'false' in production; boot guard refuses to start if 'true' with NODE_ENV=production
DEMO_MODE=false

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co       # Supabase project URL from project settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key     # Secret service_role key (server-side only, bypasses RLS)
SUPABASE_ANON_KEY=your-anon-key                     # Public anon key (optional on server, for public client proxy)

# ── Authentication & Security Keys ──────────────────────────────────────────
# Generate each 64-char hex key with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_FOR_PARTICIPANTS    # Secret used to sign participant/candidate JWTs
ADMIN_JWT_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET     # Secret used to sign admin & faculty JWTs
JWT_EXPIRY=3h                                                  # Lifespan for participant tokens (e.g., 3h, 4h)
STUDENT_JWT_EXPIRY=4h                                          # Lifespan for candidate session tokens

# ── TOTP 2FA Encryption (Mandatory in Production) ──────────────────────────
# 32+ char random key for AES-256-CTR encryption of TOTP secrets at rest. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_KEY

# ── Admin & Inspector Seed Credentials (Immunity Against Lockouts) ──────────
ADMIN_USERNAME=admin                                           # Super Admin username
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12     # Super Admin initial password (flagged must_change_password)
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12             # Fallback/alias for initial password
ADMIN_EMAIL=admin@logicwhilelire.com                           # Super Admin email
ADMIN_PHONE=+919999999999                                      # Super Admin contact phone
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH       # Super Admin bcrypt hash (optional fallback)

INSPECTOR_USERNAME=inspector                                   # Inspector username
INSPECTOR_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12 # Inspector initial password (flagged must_change_password)
INSPECTOR_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12         # Fallback/alias for initial password
INSPECTOR_EMAIL=inspector@logicwhilelire.com                   # Inspector email
INSPECTOR_PHONE=+919999999998                                  # Inspector contact phone

ADMIN_EMAIL_FROM=admin@logicwhilelire.com                       # Admin outgoing email sender (Resend)
INSPECTOR_EMAIL_FROM=inspector@logicwhilelire.com               # Inspector outgoing email sender (Resend)

# ── Networking, CORS & Domain ───────────────────────────────────────────────
# Exact URL of frontend client (no trailing slash). Render backend sets Access-Control-Allow-Origin to this.
CLIENT_ORIGIN=https://your-frontend-app.netlify.app
CLIENT_URL=https://your-frontend-app.netlify.app               # Canonical client app URL for exam links and email redirects
FRONTEND_URL=https://your-frontend-app.netlify.app             # Frontend URL used in email links (must be https:// in production)

# ── Email / Resend API & SMTP (OTP, Invitations, Alerts, Scorecards) ─────────
RESEND_API_KEY=re_your_resend_api_key                              # Resend API Key for direct HTTP delivery (preferred)
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret             # Resend webhook signing secret (from Resend Dashboard → Webhooks). Add POST /api/webhooks/resend as the endpoint URL.
EMAIL_DAILY_CAP=100                                                # Configurable daily free-tier email cap (alerts at 80%, blocks at 100%)
SMTP_HOST=smtp.resend.com                                      # Outgoing SMTP host (e.g. smtp.resend.com or smtp-relay.brevo.com)
SMTP_PORT=587                                                  # Outgoing SMTP port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_USER=resend                                               # SMTP username or API user
SMTP_PASS=re_your_smtp_api_key                                 # SMTP password or API token
SMTP_SECURE=false                                              # Set to 'true' for port 465 (SSL), 'false' for 587 (TLS)
MAIL_DOMAIN=yourdomain.com                                     # Primary mail domain, e.g. logicwhilelire.com — used for alias lookups and noreply@ address
EMAIL_FROM=noreply@yourdomain.com                              # Sender email address displayed to recipients
OTP_FROM_EMAIL=noreply@yourdomain.com                          # Sender email address specifically for OTP verifications
EMAIL_FROM_NAME=LogicWhileLiRE Assessment Portal               # Friendly sender name on outgoing emails
ADMIN_ALERT_EMAIL=admin@yourdomain.com                         # Destination email for proctoring violations & critical alerts
ADMIN_EMAIL=admin@yourdomain.com                               # Secondary alert email for proctoring monitor
MAIL_FROM_NOREPLY=noreply@yourdomain.com                      # Primary noreply sender address for Resend
MAIL_REPLY_TO=support@yourdomain.com                          # Primary reply-to address
SUPPORT_EMAIL=support@yourdomain.com                           # Support contact email displayed in email footers
INSPECTOR_ALERT_EMAIL=admin@yourdomain.com                     # Email for proctoring inspector alerts
OTP_EXPIRY_MINUTES=10                                          # OTP code validity duration (minutes)

# ── Brevo SMTP Fallback (Activates when Resend daily cap is hit) ─────────────
BREVO_SMTP_USER=                                               # Brevo login email (optional — enables SMTP fallback transport)
BREVO_SMTP_PASS=                                               # Brevo SMTP key starting with xsmtp... (or Brevo API key)
BREVO_SMTP_HOST=smtp-relay.brevo.com                           # Brevo SMTP host (default: smtp-relay.brevo.com)
BREVO_SMTP_PORT=587                                            # Brevo SMTP port (default: 587)

# ── Disaster Recovery & Automated System Backup ──────────────────────────────
# REQUIRED in production: must be an absolute path OUTSIDE the repository
BACKUP_DIR=/var/backups/logicwhilelire                         # Absolute path for backup exports (must be outside repo in production)
BACKUP_CRON_SCHEDULE="0 2 * * *"                               # Automated nightly backup cron (default: 2:00 AM UTC / 7:30 AM IST)

# ── Google Drive Cloud Backup (Optional — Service Account) ────────────────────
# Generates automated cloud sync on backup generation. Service account needs Viewer/Editor on folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=                                  # client_email from Google Cloud service account JSON key
GOOGLE_PRIVATE_KEY=                                            # private_key from service account JSON (keep literal \n escapes)
GOOGLE_DRIVE_FOLDER_ID=                                        # Target Google Drive folder ID from URL (drive.google.com/drive/folders/ID)


# ── Proctoring & Security Rules ─────────────────────────────────────────────
VIOLATION_THRESHOLD=2                                          # Tab-switch / fullscreen violations permitted before auto-termination

# ── External AI & Code Execution Gateways (Optional) ────────────────────────
OPENAI_API_KEY=                                                # (Optional) OpenAI key for question generation (built-in synthesizer used if blank)
PISTON_URL=https://emkc.org/api/v2/piston/execute             # (Optional) External code sandbox runner URL (built-in runner used if blank)
PISTON_API=                                                    # (Optional) Alias for PISTON_URL

# ── Observability & Monitoring (Optional) ───────────────────────────────────
SENTRY_DSN=                                                    # (Optional) Sentry DSN for server error tracking

