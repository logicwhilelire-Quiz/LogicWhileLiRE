# ==============================================================================
# LogicWhile QUIZ — Server Environment Configuration (Pin to Pin)
# ==============================================================================

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to client
SUPABASE_ANON_KEY=your-anon-key                    # for client-facing realtime subscriptions only

# Auth (Participant & Admin JWT)
JWT_SECRET=generate-a-long-random-string           # use `openssl rand -hex 64`
ADMIN_JWT_SECRET=generate-a-long-random-string     # use `openssl rand -hex 64` for admin
JWT_EXPIRY=3h                                      # match to longest exam duration + buffer

# Admin Credentials
ADMIN_USERNAME=set-a-real-username
# Generate with: node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$PLACEHOLDER_HASH       # never store plaintext, even in .env

# Email / OTP Delivery & Security Alerts
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-sending-address
SMTP_PASS=app-password
OTP_FROM_EMAIL=noreply@logicwhilequiz.com
ADMIN_ALERT_EMAIL=your-sending-address   # Recipient for termination alerts (defaults to SMTP_USER if unset)
OTP_EXPIRY_MINUTES=5

# Proctoring & Exam Policy
VIOLATION_THRESHOLD=2

# App & Networking
NODE_ENV=production
PORT=3001
CLIENT_ORIGIN=https://your-frontend-domain.com      # for CORS lock-down (e.g. Netlify URL)
